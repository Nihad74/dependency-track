{#- @pebvariable name="notification" type="org.dependencytrack.notification.proto.v1.Notification" -#}
{#- @pebvariable name="timestamp" type="String" -#}
--------------------------------------------------------------------------------
Notification
  -- timestamp: {{ timestamp }}
  -- level:     {{ notification.level }}
  -- scope:     {{ notification.scope }}
  -- group:     {{ notification.group }}
  -- title:     {{ notification.title }}
  -- content:   {{ notification.content }}
{% if notification.group == "GROUP_PROJECT_AUDIT_CHANGE" -%}
  -- project:   {{ subject.project | summarize }}
{% endif -%}
